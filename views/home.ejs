<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>The Blog Page</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <nav class="topnav">
    <a class="brand" href="/">Home page</a>
    <div class="links">
      <a href="/">Home</a>
      <a href="/about">About</a>
      <% if (currentUser && currentUser.isAdmin) { %>
        <a href="/admin">Admin</a>
      <% } %>
    </div>
  
    <form class="search-form" action="/search" method="GET">
      <input type="text" name="q" placeholder="Search posts...">
      <button type="submit">Search</button>
    </form>
  
    <% if (currentUser) { %>
      <a href="/profile" style="display: flex; align-items: center; gap: 0.5rem; text-decoration: none; margin-left: 1rem;">
        <div class="avatar"><%= currentUser.username[0].toUpperCase() %></div>
        <span style="font-size: 0.85rem;"><%= currentUser.username %></span>
      </a>
    <% } else { %>
      <a href="/login" style="margin-left: 1rem; font-size: 0.85rem; color: var(--text-dim);">Log in</a>
    <% } %>
  </nav>

  <main>
    <% if (posts.length === 0) { %>
      <p class="empty-state">No posts yet.</p>
    <% } else { %>
      <% posts.forEach((post, i) => { %>
        <div class="post">
          <div class="post-header">
            <div class="avatar">B</div>
            <span class="frame-no">Post #<%= i + 1 %></span>
          </div>

          <% if (post.image) { %>
            <img src="/uploads/<%= post.image %>" alt="<%= post.title %>">
          <% } %>

          <div class="post-body">
            <p class="title"><%= post.title %></p>
            <p class="content"><%= post.content %></p>
          </div>

          <div class="comments">
            <p class="count"><%= post.comments.length %> comments</p>
            <% post.comments.forEach(comment => { %>
              <p class="comment-line"><%= comment.content %></p>
            <% }) %>

            <form class="comment-form" action="/posts/<%= post._id %>/comments" method="POST">
              <input type="text" name="content" placeholder="Add a comment..." required>
              <button type="submit">Post</button>
            </form>
          </div>
        </div>
      <% }) %>
    <% } %>
  </main>
</body>
</html>