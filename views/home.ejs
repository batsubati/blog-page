<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>The Blog Page</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <nav class="topnav">
    <a class="brand" href="/">Batsukh</a>
    <div class="links">
      <a href="/">Home</a>
      <a href="/about">About</a>
      <a href="/login">Admin</a>
    </div>
  </nav>

  <main>
    <% if (posts.length === 0) { %>
      <p class="empty-state">No posts yet.</p>
    <% } else { %>
      <% posts.forEach((post, i) => { %>
        <div class="post">
          <div class="post-header">
            <div class="avatar">Y</div>
            <span class="frame-no">Post #<%= i + 1 %></span>
          </div>

          <% if (post.image) { %>
            <img src="/uploads/<%= post.image %>" alt="<%= post.title %>">
          <% } %>

          <div class="post-body">
            <p class="title"><%= post.title %></p>
            <p class="content"><%= post.content %></p>
          </div>

          <div class="comments">
            <p class="count"><%= post.comments.length %> comments</p>
            <% post.comments.forEach(comment => { %>
              <p class="comment-line"><%= comment.content %></p>
            <% }) %>

            <form class="comment-form" action="/posts/<%= post.id %>/comments" method="POST">
              <input type="text" name="content" placeholder="Add a comment..." required>
              <button type="submit">Post</button>
            </form>
          </div>
        </div>
      <% }) %>
    <% } %>
  </main>
</body>
</html>