<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Log In</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="card">
    <h1>Log in</h1>
    <% if (error) { %>
      <p style="color: var(--danger); font-size: 0.85rem; margin: -0.5rem 0 0.3rem;"><%= error %></p>
    <% } %>
    <form action="/login" method="POST">
      <input type="text" name="username" placeholder="Username" required>
      <input type="password" name="password" placeholder="Password" required>
      <button type="submit">Log in</button>
    </form>
    <p style="text-align: center; font-size: 0.82rem; color: var(--text-dim); margin-top: 1rem;">
      Don't have an account? <a href="/register" style="color: var(--accent);">Register</a>
    </p>
  </div>
</body>
</html>