<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Manage Posts — Admin</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <nav class="topnav">
    <a class="brand" href="/">Batsukh</a>
    <div class="links">
      <a href="/">Home</a>
      <a href="/admin">+ New post</a>
      <a href="/about">About</a>
    </div>
  </nav>

  <main class="wide">
    <% if (posts.length === 0) { %>
      <p class="empty-state">Nothing here yet.</p>
    <% } else { %>
      <% posts.forEach(post => { %>
        <div class="manage-row">
          <% if (post.image) { %>
            <img src="/uploads/<%= post.image %>" alt="">
          <% } %>
          <div class="details">
            <p class="title"><%= post.title %></p>
            <p class="snippet"><%= post.content %></p>

            <form action="/posts/<%= post.id %>/delete" method="POST" style="display:inline">
              <button type="submit" class="btn-danger">Delete post</button>
            </form>

            <% post.comments.forEach(comment => { %>
              <div class="manage-comment">
                <span><%= comment.content %></span>
                <form action="/comments/<%= comment.id %>/delete" method="POST">
                  <button type="submit" class="btn-danger">Remove</button>
                </form>
              </div>
            <% }) %>
          </div>
        </div>
      <% }) %>
    <% } %>
  </main>
</body>
</html>